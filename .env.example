# Copy to .env (ignored by Git) to override Makefile defaults for local runs.
# Dummy or local-only public values only; never put secret/service-role keys here.

# Comma-separated exact browser origins allowed to call the API (no wildcards).
ALLOWED_ORIGINS=http://localhost:3000

# Where `make run-api` listens. Use 0.0.0.0 only for a LAN smoke check.
API_HOST=127.0.0.1
API_PORT=8000

# Local Supabase stack used by the API to verify users (fixed local defaults;
# see `make supabase-status`). The issuer must match tokens' `iss` claim and
# stays 127.0.0.1 even when phones reach Supabase over the LAN.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
