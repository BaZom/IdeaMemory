# Copy to .env (ignored by Git) to override Makefile defaults for local runs.
# Dummy values only. Supabase and OpenAI settings are added by later tasks.

# Comma-separated exact browser origins allowed to call the API (no wildcards).
ALLOWED_ORIGINS=http://localhost:3000

# Where `make run-api` listens. Use 0.0.0.0 only for a LAN smoke check.
API_HOST=127.0.0.1
API_PORT=8000
